{
  "name": "@sufra/api", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --external:express --external:helmet --external:express-rate-limit --external:dotenv --external:zod --outfile=dist/server.js",
    "start": "NODE_ENV=production node dist/server.js"
  },
  "dependencies": {
    "@sufra/contracts": "*", "dotenv": "^17.2.3", "express": "^5.1.0",
    "express-rate-limit": "^8.2.1", "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5", "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3", "esbuild": "^0.25.12", "supertest": "^7.1.4", "tsx": "^4.20.6"
  }
}
